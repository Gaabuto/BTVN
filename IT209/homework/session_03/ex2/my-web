server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /var/www/my-web/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Dùng trang lỗi tùy biến cho 404
    error_page 404 /404.html;

    # internal: chặn truy cập trực tiếp /404.html từ bên ngoài
    location = /404.html {
        root /var/www/my-web/html;
        internal;
    }
}
